{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reverbplayground.org/schemas/patch-v2.schema.json",
  "title": "Reverb Playground patch v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engineVersion", "semantic", "layout"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "qualityPolicy": { "enum": ["draft", "normal", "high"] },
    "semantic": { "$ref": "#/$defs/semanticGraph" },
    "layout": { "$ref": "#/$defs/layout" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1 },
    "signalType": { "enum": ["audio", "control"] },
    "portDirection": { "enum": ["input", "output"] },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "signal", "direction"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "signal": { "$ref": "#/$defs/signalType" },
        "direction": { "$ref": "#/$defs/portDirection" }
      }
    },
    "modulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portId", "amount", "polarity", "clampMinimum", "clampMaximum"],
      "properties": {
        "portId": { "$ref": "#/$defs/identifier" },
        "amount": { "type": "number" },
        "polarity": { "enum": ["unipolar", "bipolar"] },
        "clampMinimum": { "type": "number" },
        "clampMaximum": { "type": "number" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "unit"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "value": { "type": "number" },
        "unit": { "enum": ["boolean", "coefficient", "curve-family", "cycles", "decibels", "direction", "hertz", "linear", "milliseconds", "normalized", "polarity", "run-mode", "semitones", "unitless", "waveform"] },
        "modulation": { "$ref": "#/$defs/modulation" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "ports", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "presentation": { "enum": ["gravity"] },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } }
      }
    },
    "portReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "portId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "portId": { "$ref": "#/$defs/identifier" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/portReference" },
        "to": { "$ref": "#/$defs/portReference" }
      }
    },
    "semanticGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "connections"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } }
      }
    },
    "nodePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "x", "y"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "layoutGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "collapsed", "nodeIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "collapsed": { "type": "boolean" },
        "nodeIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "layoutCable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId"],
      "anyOf": [{ "required": ["waypoints"] }, { "required": ["portal"] }],
      "properties": {
        "edgeId": { "$ref": "#/$defs/identifier" },
        "waypoints": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/point" } },
        "portal": {
          "type": "object", "additionalProperties": false, "required": ["name"],
          "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 32 } }
        }
      }
    },
    "subpatchPort": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "signal", "direction", "nodeId", "portId"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "signal": { "$ref": "#/$defs/signalType" },
        "direction": { "$ref": "#/$defs/portDirection" }, "nodeId": { "$ref": "#/$defs/identifier" },
        "portId": { "$ref": "#/$defs/identifier" }
      }
    },
    "subpatchInstance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "definitionId", "definitionVersion", "definitionName", "memberNodeIds", "ports"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "definitionId": { "$ref": "#/$defs/identifier" },
        "definitionVersion": { "type": "integer", "minimum": 1 },
        "definitionName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "memberNodeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subpatchPort" } }
      }
    },
    "hierarchyPortTarget": {
      "type": "object", "additionalProperties": false, "required": ["nodeId", "portId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "portId": { "$ref": "#/$defs/identifier" }
      }
    },
    "hierarchyPort": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "signal", "direction", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "signal": { "$ref": "#/$defs/signalType" },
        "direction": { "$ref": "#/$defs/portDirection" },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hierarchyPortTarget" } }
      }
    },
    "hierarchyPresentation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "collapsed", "memberNodeIds", "position", "nestedViewport", "ports"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["compound", "subpatch"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "collapsed": { "type": "boolean" },
        "memberNodeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "position": { "$ref": "#/$defs/point" },
        "nestedViewport": { "$ref": "#/$defs/viewport" },
        "ports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hierarchyPort" } },
        "parentId": { "$ref": "#/$defs/identifier" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "viewport"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/nodePosition" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/layoutGroup" } },
        "cables": { "type": "array", "items": { "$ref": "#/$defs/layoutCable" } },
        "subpatches": { "type": "array", "items": { "$ref": "#/$defs/subpatchInstance" } },
        "hierarchies": { "type": "array", "items": { "$ref": "#/$defs/hierarchyPresentation" } },
        "viewport": { "$ref": "#/$defs/viewport" }
      }
    }
  }
}
